{
  "id": "flow-003-partnership",
  "slug": "003-partnership-pitch",
  "name": "Business Deal / Partnership Pitch Flow",
  "category": "partnership",
  "description": "Identify a target partner, build the pitch, run the outreach, and convert into a closed deal.",
  "purpose": "Move from 'we should partner with X' to a signed agreement, with negotiation discipline and approval gates at every commitment point.",
  "status": "published",
  "version": 1,
  "agents": ["research", "business", "finance"],
  "triggerConditions": ["manual"],
  "userFacingLabel": "Build Partnership",
  "userFacingBlurb": "Pitch and close a business deal — research, draft, negotiate.",
  "icon": "Handshake",
  "stages": [
    {
      "id": "s1-target",
      "order": 1,
      "name": "Target Profile",
      "assignedAgent": "research",
      "requiresApproval": false,
      "outputs": ["report"],
      "steps": [
        { "id": "s1-1", "order": 1, "label": "Profile the target org and decision-makers" },
        { "id": "s1-2", "order": 2, "label": "Map their goals, constraints, and current vendors" },
        { "id": "s1-3", "order": 3, "label": "Find the warmest contact path" }
      ]
    },
    {
      "id": "s2-value",
      "order": 2,
      "name": "Mutual Value Hypothesis",
      "assignedAgent": "business",
      "requiresApproval": true,
      "approvalRole": "user",
      "outputs": ["decision_log"],
      "steps": [
        { "id": "s2-1", "order": 1, "label": "Articulate the value WE provide them" },
        { "id": "s2-2", "order": 2, "label": "Articulate the value THEY provide us" },
        { "id": "s2-3", "order": 3, "label": "Define the shape of the deal (revenue share, equity, comarketing, etc.)" }
      ]
    },
    {
      "id": "s3-pitch",
      "order": 3,
      "name": "Pitch Asset Pack",
      "assignedAgent": "business",
      "requiresApproval": true,
      "approvalRole": "user",
      "outputs": ["draft", "campaign_plan"],
      "steps": [
        { "id": "s3-1", "order": 1, "label": "One-page partnership memo" },
        { "id": "s3-2", "order": 2, "label": "Outreach email + warm intro request" },
        { "id": "s3-3", "order": 3, "label": "Slide deck or one-pager (3 slides max)" }
      ]
    },
    {
      "id": "s4-outreach",
      "order": 4,
      "name": "Outreach & First Meeting",
      "assignedAgent": "operations",
      "requiresApproval": false,
      "outputs": ["task_list"],
      "steps": [
        { "id": "s4-1", "order": 1, "label": "Send pitch through warmest path" },
        { "id": "s4-2", "order": 2, "label": "Schedule discovery meeting" },
        { "id": "s4-3", "order": 3, "label": "Capture meeting notes and next steps" }
      ]
    },
    {
      "id": "s5-terms",
      "order": 5,
      "name": "Terms & Risk Review",
      "assignedAgent": "finance",
      "requiresApproval": true,
      "approvalRole": "admin",
      "outputs": ["decision_log", "recommendation"],
      "steps": [
        { "id": "s5-1", "order": 1, "label": "Model the financial implications" },
        { "id": "s5-2", "order": 2, "label": "List risks and mitigations" },
        { "id": "s5-3", "order": 3, "label": "Recommend signing / revising / walking" }
      ]
    },
    {
      "id": "s6-close",
      "order": 6,
      "name": "Close & Onboard",
      "assignedAgent": "business",
      "requiresApproval": false,
      "outputs": ["task_list"],
      "steps": [
        { "id": "s6-1", "order": 1, "label": "Sign agreement" },
        { "id": "s6-2", "order": 2, "label": "Kick-off plan" },
        { "id": "s6-3", "order": 3, "label": "Define joint KPIs and review cadence" }
      ]
    }
  ],
