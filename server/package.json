{
  "name": "zed-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "npm install --prefix ../shared",
    "dev": "tsx watch --ignore '../client/**' index.ts",
    "start": "tsx index.ts",
    "smoke": "tsx scripts/smokeCheck.ts",
    "verify:execution": "tsx scripts/executionVerification.ts",
    "verify:live": "tsx scripts/liveExecutionVerification.ts",
    "merge-memory": "tsx scripts/mergeMemorySources.ts",
    "compact-memory": "tsx scripts/compactFoundationMemory.ts",
    "memory:foundation:dry-run": "tsx scripts/reparseFoundationMemoryToGraph.ts",
    "memory:foundation:apply": "tsx scripts/reparseFoundationMemoryToGraph.ts --apply",
    "memory:reparse-objects": "tsx scripts/reparseBaseMemoryToObjects.ts --dry-run --write-markdown",
    "memory:reparse-objects:apply": "tsx scripts/reparseBaseMemoryToObjects.ts --apply --write-markdown"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.1.0",
    "@vitejs/plugin-react": "^6.0.1",
    "chromadb": "^3.4.3",
    "drizzle-orm": "^0.45.1",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "js-yaml": "^4.3.0",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "nanoid": "^5.1.7",
    "nodemailer": "^8.0.5",
    "playwright-core": "^1.49.1",
    "sanitize-html": "^2.17.6",
    "vite": "^8.1.5",
    "ws": "^8.20.0",
    "yauzl": "^3.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/express-session": "^1.18.1",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^6.4.17",
    "@types/sanitize-html": "^2.16.1",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
