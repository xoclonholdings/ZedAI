<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZED AI - Enhanced Assistant</title>
    <script>
        // Redirect to the ZED AI interface
        window.location.href = '/zed-ui/interfaces/zed-interface.html';
    </script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            color: #fff;
            min-height: 100vh;
            padding: 20px;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        
        .header {
            text-align: center;
            margin-bottom: 40px;
        }
        
        .header h1 {
            font-size: 3rem;
            margin-bottom: 10px;
            background: linear-gradient(45deg, #4CAF50, #45a049);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .header p {
            font-size: 1.2rem;
            opacity: 0.8;
        }
        
        .main-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-bottom: 40px;
        }
        
        .card {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 30px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        
        .card h3 {
            font-size: 1.5rem;
            margin-bottom: 20px;
            color: #4CAF50;
        }
        
        .upload-area {
            border: 3px dashed #4CAF50;
            border-radius: 15px;
            padding: 40px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-bottom: 20px;
        }
        
        .upload-area:hover {
            background: rgba(76, 175, 80, 0.1);
            border-color: #45a049;
        }
        
        .upload-area.dragover {
            background: rgba(76, 175, 80, 0.2);
            border-color: #45a049;
        }
        
        .btn {
            background: linear-gradient(45deg, #4CAF50, #45a049);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 1rem;
            transition: all 0.3s ease;
            margin: 5px;
        }
        
        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(76, 175, 80, 0.4);
        }
        
        .btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }
        
        .memory-type-selector {
            margin-bottom: 20px;
        }
        
        .memory-type-selector select {
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            font-size: 1rem;
        }
        
        .chat-area {
            height: 300px;
            overflow-y: auto;
            background: rgba(0, 0, 0, 0.3);
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
        }
        
        .chat-message {
            margin-bottom: 15px;
            padding: 10px;
            border-radius: 8px;
        }
        
        .chat-message.user {
            background: rgba(76, 175, 80, 0.2);
            text-align: right;
        }
        
        .chat-message.ai {
            background: rgba(33, 150, 243, 0.2);
        }
        
        .chat-input {
            display: flex;
            gap: 10px;
        }
        
        .chat-input input {
            flex: 1;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            font-size: 1rem;
        }
        
        .status-area {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 10px;
            padding: 20px;
            margin-top: 20px;
        }
        
        .status-indicator {
            display: inline-block;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            margin-right: 8px;
        }
        
        .status-indicator.connected {
            background: #4CAF50;
        }
        
        .status-indicator.disconnected {
            background: #f44336;
        }
        
        .memory-list {
            max-height: 300px;
            overflow-y: auto;
        }
        
        .memory-item {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 10px;
            border-left: 4px solid #4CAF50;
        }
        
        .memory-item h4 {
            color: #4CAF50;
            margin-bottom: 5px;
        }
        
        .memory-item p {
            font-size: 0.9rem;
            opacity: 0.8;
        }
        
        @media (max-width: 768px) {
            .main-grid {
                grid-template-columns: 1fr;
            }
            
            .header h1 {
                font-size: 2rem;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🧠 ZED AI</h1>
            <p>Advanced Memory Upload & Organization System</p>
        </div>

        <div class="main-grid">
            <!-- Memory Upload Section -->
            <div class="card">
                <h3>📤 Memory Upload</h3>
                
                <div class="memory-type-selector">
                    <select id="memoryType">
                        <option value="text">Text Memory</option>
                        <option value="conversation">Conversation Archive</option>
                        <option value="image_batch">Image Collection</option>
                        <option value="mixed_folder">Mixed Content Folder</option>
                    </select>
                </div>
                
                <div class="upload-area" id="uploadArea">
                    <div id="uploadContent">
                        <h4>📁 Drop files here or click to upload</h4>
                        <p>ZED will automatically organize and compress your memory data</p>
                    </div>
                    <input type="file" id="fileInput" multiple style="display: none;">
                </div>
                
                <div style="display: flex; gap: 10px;">
                    <button class="btn" onclick="triggerFileSelect()">📁 Select Files</button>
                    <button class="btn" onclick="uploadMemory()" id="uploadBtn" disabled>🚀 Upload & Process</button>
                </div>
            </div>

            <!-- Chat Interface -->
            <div class="card">
                <h3>💬 Chat with ZED</h3>
                
                <div class="chat-area" id="chatArea">
                    <div class="chat-message ai">
                        <strong>ZED:</strong> Hello! I'm ready to help you organize your memories. Upload some data and I'll process it intelligently.
                    </div>
                </div>
                
                <div class="chat-input">
                    <input type="text" id="messageInput" placeholder="Ask ZED about your memories..." onkeypress="handleChatKeypress(event)">
                    <button class="btn" onclick="sendMessage()">Send</button>
                </div>
            </div>
        </div>

        <!-- Memory Explorer -->
        <div class="card">
            <h3>🗃️ Memory Explorer</h3>
            <div style="display: flex; gap: 10px; margin-bottom: 20px;">
                <button class="btn" onclick="loadMemories()">🔄 Refresh</button>
                <button class="btn" onclick="searchMemories()">🔍 Search</button>
                <input type="text" id="searchInput" placeholder="Search memories..." style="flex: 1; padding: 8px; border-radius: 5px; border: 1px solid #ccc;">
            </div>
            <div class="memory-list" id="memoryList">
                <p style="text-align: center; opacity: 0.7;">No memories uploaded yet. Start by uploading some data above!</p>
            </div>
        </div>

        <!-- Status Area -->
        <div class="status-area">
            <h4>🔧 System Status</h4>
            <div id="systemStatus">
                <p><span class="status-indicator disconnected"></span>Checking connection...</p>
            </div>
        </div>
    </div>

    <script>
        let selectedFiles = [];
        let systemHealth = {};

        // Initialize the application
        document.addEventListener('DOMContentLoaded', function() {
            checkSystemHealth();
            setupUploadArea();
            loadMemories();
        });

        // Setup drag and drop upload area
        function setupUploadArea() {
            const uploadArea = document.getElementById('uploadArea');
            const fileInput = document.getElementById('fileInput');

            uploadArea.addEventListener('click', () => fileInput.click());
            uploadArea.addEventListener('dragover', handleDragOver);
            uploadArea.addEventListener('dragleave', handleDragLeave);
            uploadArea.addEventListener('drop', handleDrop);

            fileInput.addEventListener('change', handleFileSelect);
        }

        function handleDragOver(e) {
            e.preventDefault();
            e.currentTarget.classList.add('dragover');
        }

        function handleDragLeave(e) {
            e.preventDefault();
            e.currentTarget.classList.remove('dragover');
        }

        function handleDrop(e) {
            e.preventDefault();
            e.currentTarget.classList.remove('dragover');
            const files = Array.from(e.dataTransfer.files);
            processFiles(files);
        }

        function triggerFileSelect() {
            document.getElementById('fileInput').click();
        }

        function handleFileSelect(e) {
            const files = Array.from(e.target.files);
            processFiles(files);
        }

        function processFiles(files) {
            selectedFiles = files;
            const uploadContent = document.getElementById('uploadContent');
            const uploadBtn = document.getElementById('uploadBtn');

            if (files.length > 0) {
                uploadContent.innerHTML = `
                    <h4>📁 ${files.length} file(s) selected</h4>
                    <p>${files.map(f => f.name).slice(0, 3).join(', ')}${files.length > 3 ? '...' : ''}</p>
                `;
                uploadBtn.disabled = false;
            } else {
                uploadContent.innerHTML = `
                    <h4>📁 Drop files here or click to upload</h4>
                    <p>ZED will automatically organize and compress your memory data</p>
                `;
                uploadBtn.disabled = true;
            }
        }

        async function uploadMemory() {
            if (selectedFiles.length === 0) return;

            const memoryType = document.getElementById('memoryType').value;
            const uploadBtn = document.getElementById('uploadBtn');
            
            uploadBtn.disabled = true;
            uploadBtn.textContent = '⏳ Processing...';

            try {
                // Convert files to base64 for upload
                const processedFiles = await Promise.all(
                    selectedFiles.map(async (file) => {
                        const content = await fileToBase64(file);
                        return {
                            filename: file.name,
                            content: content,
                            size: file.size,
                            type: file.type,
                            metadata: {
                                lastModified: file.lastModified,
                                size: file.size
                            }
                        };
                    })
                );

                const response = await fetch('/.netlify/functions/memory-upload', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        type: memoryType,
                        data: processedFiles,
                        metadata: {
                            upload_timestamp: new Date().toISOString(),
                            file_count: selectedFiles.length,
                            user_agent: navigator.userAgent
                        }
                    })
                });

                const result = await response.json();

                if (result.success) {
                    addChatMessage('ai', `✅ Memory uploaded successfully! Upload ID: ${result.upload_id}. Processing result: ${JSON.stringify(result.processing_result, null, 2)}`);
                    loadMemories();
                } else {
                    addChatMessage('ai', `❌ Upload failed: ${result.error || 'Unknown error'}`);
                }

            } catch (error) {
                console.error('Upload error:', error);
                addChatMessage('ai', `❌ Upload failed: ${error.message}`);
            } finally {
                uploadBtn.disabled = false;
                uploadBtn.textContent = '🚀 Upload & Process';
                selectedFiles = [];
                processFiles([]);
            }
        }

        async function fileToBase64(file) {
            return new Promise((resolve, reject) => {
                if (file.type.startsWith('text/') || file.name.endsWith('.json') || file.name.endsWith('.html')) {
                    // For text files, read as text
                    const reader = new FileReader();
                    reader.onload = () => resolve(reader.result);
                    reader.onerror = reject;
                    reader.readAsText(file);
                } else {
                    // For binary files, read as base64
                    const reader = new FileReader();
                    reader.onload = () => {
                        const base64 = reader.result.split(',')[1];
                        resolve(base64);
                    };
                    reader.onerror = reject;
                    reader.readAsDataURL(file);
                }
            });
        }

        async function sendMessage() {
            const messageInput = document.getElementById('messageInput');
            const message = messageInput.value.trim();
            
            if (!message) return;

            addChatMessage('user', message);
            messageInput.value = '';

            try {
                const response = await fetch('/.netlify/functions/chat', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        message: message,
                        model: 'llama2'
                    })
                });

                const result = await response.json();

                if (result.response) {
                    addChatMessage('ai', result.response);
                } else {
                    addChatMessage('ai', `Error: ${result.error || 'No response received'}`);
                }

            } catch (error) {
                console.error('Chat error:', error);
                addChatMessage('ai', `Connection error: ${error.message}`);
            }
        }

        function handleChatKeypress(event) {
            if (event.key === 'Enter') {
                sendMessage();
            }
        }

        function addChatMessage(sender, message) {
            const chatArea = document.getElementById('chatArea');
            const messageDiv = document.createElement('div');
            messageDiv.className = `chat-message ${sender}`;
            messageDiv.innerHTML = `<strong>${sender === 'user' ? 'You' : 'ZED'}:</strong> ${message}`;
            chatArea.appendChild(messageDiv);
            chatArea.scrollTop = chatArea.scrollHeight;
        }

        async function loadMemories() {
            try {
                const response = await fetch('/.netlify/functions/memory-upload');
                const result = await response.json();

                const memoryList = document.getElementById('memoryList');
                
                if (result.memories && result.memories.length > 0) {
                    memoryList.innerHTML = result.memories.map(memory => `
                        <div class="memory-item">
                            <h4>${memory.type} - ${memory.upload_id}</h4>
                            <p>Created: ${new Date(memory.created).toLocaleString()}</p>
                            <p>Status: ${memory.status}</p>
                            ${memory.processing_result ? `<p>Files: ${JSON.stringify(memory.processing_result).substring(0, 100)}...</p>` : ''}
                        </div>
                    `).join('');
                } else {
                    memoryList.innerHTML = '<p style="text-align: center; opacity: 0.7;">No memories found. Upload some data to get started!</p>';
                }

            } catch (error) {
                console.error('Error loading memories:', error);
                document.getElementById('memoryList').innerHTML = '<p style="color: #f44336;">Error loading memories</p>';
            }
        }

        async function checkSystemHealth() {
            try {
                const response = await fetch('/.netlify/functions/health');
                systemHealth = await response.json();

                const statusDiv = document.getElementById('systemStatus');
                const isHealthy = systemHealth.status === 'healthy';
                const ollamaConnected = systemHealth.ollama?.status === 'connected';

                statusDiv.innerHTML = `
                    <p><span class="status-indicator ${isHealthy ? 'connected' : 'disconnected'}"></span>System: ${systemHealth.status}</p>
                    <p><span class="status-indicator ${ollamaConnected ? 'connected' : 'disconnected'}"></span>Ollama: ${systemHealth.ollama?.status || 'unknown'}</p>
                    <p>🧠 Models: ${systemHealth.ollama?.models?.join(', ') || 'None detected'}</p>
                    <p>💾 Memory: ${systemHealth.memory?.status || 'unknown'}</p>
                    <p>🕒 Last check: ${new Date(systemHealth.timestamp).toLocaleTimeString()}</p>
                `;

            } catch (error) {
                console.error('Health check failed:', error);
                document.getElementById('systemStatus').innerHTML = `
                    <p><span class="status-indicator disconnected"></span>System: Error</p>
                    <p>Unable to connect to backend services</p>
                `;
            }
        }

        async function searchMemories() {
            const searchTerm = document.getElementById('searchInput').value;
            if (!searchTerm) {
                loadMemories();
                return;
            }

            try {
                const response = await fetch(`/.netlify/functions/memory-upload?search=${encodeURIComponent(searchTerm)}`);
                const result = await response.json();

                const memoryList = document.getElementById('memoryList');
                
                if (result.memories && result.memories.length > 0) {
                    memoryList.innerHTML = result.memories.map(memory => `
                        <div class="memory-item">
                            <h4>${memory.type} - ${memory.upload_id}</h4>
                            <p>Created: ${new Date(memory.created).toLocaleString()}</p>
                            <p>Status: ${memory.status}</p>
                            <p>Search match in: ${memory.type}</p>
                        </div>
                    `).join('');
                } else {
                    memoryList.innerHTML = `<p style="text-align: center; opacity: 0.7;">No memories found matching "${searchTerm}"</p>`;
                }

            } catch (error) {
                console.error('Search error:', error);
                document.getElementById('memoryList').innerHTML = '<p style="color: #f44336;">Search failed</p>';
            }
        }

        // Auto-refresh system status every 30 seconds
        setInterval(checkSystemHealth, 30000);
    </script>
</body>
</html>